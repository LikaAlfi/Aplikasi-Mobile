  void _addItem(MerchItem item) {
    setState(() {
      if (item.category == 'Photocard') {
        photocardItems.add(item);
      } else if (item.category == 'Album') {
        albumItems.add(item);
      } else if (item.category == 'Lightstick') {
        lightstickItems.add(item);
      }
    });
  }

  void _onItemDeleted(MerchItem item) {
    setState(() {
      if (item.category == 'Photocard') {
        photocardItems.removeWhere((i) => i.id == item.id);
      } else if (item.category == 'Album') {
        albumItems.removeWhere((i) => i.id == item.id);
      } else if (item.category == 'Lightstick') {
        lightstickItems.removeWhere((i) => i.id == item.id);
      }
    });
