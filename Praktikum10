class AddCollectionPopup extends StatefulWidget {
  const AddCollectionPopup({super.key});

  @override
  State<AddCollectionPopup> createState() => _AddCollectionPopupState();
}

class _AddCollectionPopupState extends State<AddCollectionPopup> {
  String? _selectedCategory;
  final TextEditingController _nameController = TextEditingController();
  final TextEditingController _descController = TextEditingController();
  final List<String> _categories = ['Photocard', 'Album', 'Lightstick'];

  @override
  void dispose() {
    _nameController.dispose();
    _descController.dispose();
    super.dispose();
  }

  InputDecoration _fieldDecoration(String hint) {
    return InputDecoration(
      hintText: hint,
      hintStyle: TextStyle(color: Colors.white.withOpacity(0.3), fontSize: 14),
      filled: true,
      fillColor: const Color(0xFF0A1A0F),
      contentPadding: const EdgeInsets.symmetric(horizontal: 16, vertical: 14),
      border: OutlineInputBorder(
        borderRadius: BorderRadius.circular(10),
        borderSide: BorderSide(color: const Color(0xFFB5F248).withOpacity(0.2)),
      ),
      enabledBorder: OutlineInputBorder(
        borderRadius: BorderRadius.circular(10),
        borderSide: BorderSide(color: const Color(0xFFB5F248).withOpacity(0.2)),
      ),
      focusedBorder: OutlineInputBorder(
        borderRadius: BorderRadius.circular(10),
        borderSide: const BorderSide(color: Color(0xFFB5F248), width: 1.5),
      ),
    );
  }

  void _simpan() {
    if (_selectedCategory == null || _nameController.text.trim().isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: const Text('Kategori dan nama wajib diisi!'),
          backgroundColor: Colors.red[700],
          behavior: SnackBarBehavior.floating,
          shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
        ),
      );
      return;
    }

    final newItem = MerchItem(
      id: DateTime.now().millisecondsSinceEpoch,
      name: _nameController.text.trim(),
      description: _descController.text.trim().isEmpty
          ? '-'
          : _descController.text.trim(),
      label: _selectedCategory == 'Photocard'
          ? 'NCT DREAM'
          : _selectedCategory == 'Album'
              ? 'NCT'
              : 'NCT',
      category: _selectedCategory!,
      progress: 1.0,
    );

    Navigator.pop(context, newItem);
  }

